{
  "name": "nofinance-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server.ts",
    "start": "npm run build:web && tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "seed:demo": "tsx scripts/seed.ts",
    "build:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/app.js",
    "dev:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js --watch",
    "user:create": "tsx scripts/user-create.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "migrate:ci": "node scripts/migrate-ci.mjs",
    "test:e2e": "npm run build:web && tsx test/e2e/smoke.e2e.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "pg": "8.23.1",
    "qrcode-generator": "1.4.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
