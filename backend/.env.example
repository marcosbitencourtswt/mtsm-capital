# Copie para .env. Nunca versione o .env.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/nofinance
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/nofinance_test
PORT=3333
# WSL: use 0.0.0.0 para o navegador do Windows enxergar a API
HOST=127.0.0.1
# Windows: pasta do pg_dump, se o backup não o encontrar. Ex.: C:\Program Files\PostgreSQL\16\bin
PG_BIN=
# Segredo da rotina agendada (Vercel Cron). Gere com: openssl rand -hex 32
CRON_SECRET=
TZ=America/Sao_Paulo

# Código para criar o primeiro administrador pelo navegador (16+ caracteres). Gere com: openssl rand -hex 16
SETUP_TOKEN=
